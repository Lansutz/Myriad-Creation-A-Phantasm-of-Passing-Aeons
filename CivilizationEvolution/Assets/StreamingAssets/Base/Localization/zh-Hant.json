{
  "entries": [
    {
      "key": "ethos_endurance_name",
      "value": "堅忍"
    },
    {
      "key": "ethos_endurance_desc",
      "value": "以苦為常，以韌為德。兵災、饑饉與漫長的遷徙都磨不垮這個族群的脊樑；他們相信苦難是鍛打，忍耐是榮耀。"
    },
    {
      "key": "ethos_hospitable_name",
      "value": "好客"
    },
    {
      "key": "ethos_hospitable_desc",
      "value": "遠客進門即貴賓。這個族群以款待為榮，往來商旅、流亡者與異鄉使節在這裡總能得到一碗熱食與一夜安穩——也帶回他們的口碑與情報。"
    },
    {
      "key": "ethos_warlike_name",
      "value": "尚武"
    },
    {
      "key": "ethos_warlike_desc",
      "value": "榮譽在刀鋒上。這個族群崇尚勇武與戰功，成年禮與葬禮都圍繞武事展開；對外是鋒利的矛，對內是嚴密的盾。"
    },
    {
      "key": "ethos_orderly_name",
      "value": "守序"
    },
    {
      "key": "ethos_orderly_desc",
      "value": "萬物有序，各安其位。祭祀的時辰、田畝的界限、長幼的尊卑，都要分毫不亂；秩序本身即是這個族群對世界最大的敬畏。"
    },
    {
      "key": "ethos_pioneering_name",
      "value": "開拓"
    },
    {
      "key": "ethos_pioneering_desc",
      "value": "地平線之外總有新土。這個族群不安於故地，擅長在陌生的山水間開闢居所；他們的遷徙是播種，而非逃亡。"
    },
    {
      "key": "ethos_scholarly_name",
      "value": "崇智"
    },
    {
      "key": "ethos_scholarly_desc",
      "value": "竹簡重於刀劍，問學高於問卜。這個族群珍視技藝、文字與先賢的言語，工匠與記史者在族中享有尊位。"
    },
    {
      "key": "ethos_communal_name",
      "value": "共濟"
    },
    {
      "key": "ethos_communal_desc",
      "value": "一人的饑荒是眾人的饑荒，一家的婚禮是全族的慶典。這個族群以氏族互助為根基，貧富與貴賤的鴻溝始終難以徹底裂開。"
    },
    {
      "key": "ethos_mystical_name",
      "value": "崇靈"
    },
    {
      "key": "ethos_mystical_desc",
      "value": "萬物有靈，山川草木皆可對話。這個族群的氣質浸染著對不可見之物的敬畏，祭司與夢者的話語在集會中有沉甸甸的分量。"
    },
    {
      "key": "trad_agrarian_rites_name",
      "value": "農耕禮俗"
    },
    {
      "key": "trad_agrarian_rites_desc",
      "value": "播種、開鐮、儲糧皆有定時定禮，土地神龕遍佈田埂；歉收之年全族按禮減食共渡。"
    },
    {
      "key": "trad_pastoral_riding_name",
      "value": "遊牧騎射"
    },
    {
      "key": "trad_pastoral_riding_desc",
      "value": "馬背是搖籃也是戰場，幼童先學挽弓後學執筆；逐水草而居，帳篷為家。"
    },
    {
      "key": "trad_maritime_trade_name",
      "value": "海洋貿易"
    },
    {
      "key": "trad_maritime_trade_desc",
      "value": "舟楫往來如織，港市通曉四方貨殖；海上規矩重於陸地律法，船主在族中說話擲地有聲。"
    },
    {
      "key": "trad_craft_guild_name",
      "value": "工匠傳承"
    },
    {
      "key": "trad_craft_guild_desc",
      "value": "百工之技口傳心授，爐火與錘聲不絕；匠戶自成行會，秘方只在嫡傳間流轉。"
    },
    {
      "key": "trad_ancestor_cult_name",
      "value": "祖先祭祀"
    },
    {
      "key": "trad_ancestor_cult_desc",
      "value": "先人的牌位與墳塚是族群的根脈，春秋二祭全族肅穆；忤逆祖先者被視為最重的罪。"
    },
    {
      "key": "trad_iconoclast_name",
      "value": "破壞聖像"
    },
    {
      "key": "trad_iconoclast_desc",
      "value": "偶像與圖像是矇蔽人心的塵土，真正的虔信在於棄絕形相；先人的畫像同樣在破除之列。"
    },
    {
      "key": "trad_epic_oral_name",
      "value": "歌謠史詩"
    },
    {
      "key": "trad_epic_oral_desc",
      "value": "族群的記憶不在竹帛而在歌喉，吟遊者傳唱先祖的功業與悲歡；每一代歌者都往長詩裡添上自己的一章。"
    },
    {
      "key": "trad_council_assembly_name",
      "value": "族眾議事"
    },
    {
      "key": "trad_council_assembly_desc",
      "value": "大事開帳議事，長老、勇士與智者各執一席；共識不成則事不興，議而不決的代價是行動遲緩。"
    },
    {
      "key": "trad_communal_field_name",
      "value": "氏族共耕"
    },
    {
      "key": "trad_communal_field_desc",
      "value": "田不私有，收成按戶分賬；犁鏵與種子由族庫共置，荒年互相周濟。"
    },
    {
      "key": "trad_war_bands_name",
      "value": "親兵制度"
    },
    {
      "key": "trad_war_bands_desc",
      "value": "首領的親兵食於首領之門，誓以性命相酬；親兵之子仍為親兵，世代相襲。"
    },
    {
      "key": "trad_boundary_rites_name",
      "value": "界碑祭祀"
    },
    {
      "key": "trad_boundary_rites_desc",
      "value": "族土四至立碑設祭，越界而耕者以盜論；碑在則土在，碑失則人心動搖。"
    },
    {
      "key": "laethis_lang_name",
      "value": "萊希斯語"
    },
    {
      "key": "laethis_lang_desc",
      "value": "河谷農耕之民的語言，音節清晰、輔音柔和，地名常以自然特徵與聚落通名複合而成；與冶銅、貿易相關的詞彙借自相鄰族群。"
    },
    {
      "key": "laethis_lang_script",
      "value": "音節文字"
    },
    {
      "key": "laethis_lang_naming",
      "value": "地名=自然特徵+通名（Vael-port、Cinder-hold、Laemor）；人名雙音節為主，姓氏多源自職業或地貌"
    },
    {
      "key": "ethnos_laethis_name",
      "value": "萊希斯"
    },
    {
      "key": "ethnos_laethis_desc",
      "value": "河谷與丘陵間的農耕之民，善冶銅與貿易，以崇智為族群精神；共同語言萊希斯語，承載農耕禮俗、工匠傳承與祖先祭祀諸傳統。"
    },
    {
      "key": "famtrad_scholarly_legacy_name",
      "value": "耕讀傳家"
    },
    {
      "key": "famtrad_scholarly_legacy_desc",
      "value": "詩書傳家，子弟以課讀為業，門楣常懸「耕讀」匾額；幾代人下來，家族裡總能出幾個博學明理之人。"
    },
    {
      "key": "famtrad_warlike_legacy_name",
      "value": "尚武傳家"
    },
    {
      "key": "famtrad_warlike_legacy_desc",
      "value": "祖輩以軍功起家，子弟自幼習武，家祭必陳兵刃；這個家族的血脈裡流淌著對刀弓的親近。"
    },
    {
      "key": "famtrad_merchant_legacy_name",
      "value": "商賈傳家"
    },
    {
      "key": "famtrad_merchant_legacy_desc",
      "value": "家業起於市井，帳房與貨棧是家族最熟悉的風景；經商之道代代口傳，秤上功夫不輸刀兵。"
    },
    {
      "key": "famtrad_dignitary_legacy_name",
      "value": "簪纓世家"
    },
    {
      "key": "famtrad_dignitary_legacy_desc",
      "value": "世代簪纓，族中出過數位顯宦；門第之見深植於心，子弟以仕進為榮，以失儀為恥。"
    },
    {
      "key": "famtrad_luxury_style_name",
      "value": "奢華門風"
    },
    {
      "key": "famtrad_luxury_style_desc",
      "value": "錦衣玉食，宴飲無度，族中子弟以排場為體面；家底雖厚，風氣卻日漸驕奢。"
    },
    {
      "key": "famtrad_thrifty_style_name",
      "value": "節儉家風"
    },
    {
      "key": "famtrad_thrifty_style_desc",
      "value": "一粥一飯當思來處，族規明定婚喪嫁娶的用度；積攢下來的家底，都是錙銖之間省出來的。"
    },
    {
      "key": "tmpl_commoner_name",
      "value": "平民"
    },
    {
      "key": "tmpl_commoner_desc",
      "value": "尋常百姓，生於里巷，長於田畝，各安本分。"
    },
    {
      "key": "tmpl_noble_name",
      "value": "貴族"
    },
    {
      "key": "tmpl_noble_desc",
      "value": "簪纓門第，自幼習禮，通曉門閥往來的規矩。"
    },
    {
      "key": "tmpl_military_name",
      "value": "武將"
    },
    {
      "key": "tmpl_military_desc",
      "value": "弓馬嫻熟，長於行伍，聞戰則喜。"
    },
    {
      "key": "tmpl_scholar_name",
      "value": "文臣"
    },
    {
      "key": "tmpl_scholar_desc",
      "value": "飽讀詩書，明經通史，以文墨為刀筆。"
    },
    {
      "key": "tmpl_ruler_name",
      "value": "統治者"
    },
    {
      "key": "tmpl_ruler_desc",
      "value": "一國之主，握權柄、決賞罰，須通軍政民生。"
    },
    {
      "key": "tmpl_spouse_name",
      "value": "配偶"
    },
    {
      "key": "tmpl_spouse_desc",
      "value": "主君內助，周旋於家宅與朝堂之間。"
    },
    {
      "key": "talent_photographic_name",
      "value": "過目不忘"
    },
    {
      "key": "talent_photographic_desc",
      "value": "記憶超群，見聞過目成誦，經史子集讀一遍便烙印在腦海。"
    },
    {
      "key": "talent_divine_strength_name",
      "value": "神力"
    },
    {
      "key": "talent_divine_strength_desc",
      "value": "天生神力，可舉鼎、可搏虎，尋常人兩三下都近不得身。"
    },
    {
      "key": "talent_iron_body_name",
      "value": "鐵軀"
    },
    {
      "key": "talent_iron_body_desc",
      "value": "體格強韌異於常人，寒暑不侵、傷病難纏，壽數綿長。"
    },
    {
      "key": "talent_keen_mind_name",
      "value": "慧心"
    },
    {
      "key": "talent_keen_mind_desc",
      "value": "穎悟絕倫，一點即通，旁人多年的學問他數月便瞭然於胸。"
    },
    {
      "key": "defect_frail_name",
      "value": "先天體弱"
    },
    {
      "key": "defect_frail_desc",
      "value": "胎裡帶的孱弱，風吹便倒，一場小病也要將養半年，壽元受損。"
    },
    {
      "key": "defect_feeblemind_name",
      "value": "癡愚"
    },
    {
      "key": "defect_feeblemind_desc",
      "value": "心智矇昧，難以開化，教他說話認字都要費盡周章。"
    },
    {
      "key": "defect_hemophilia_name",
      "value": "血友病"
    },
    {
      "key": "defect_hemophilia_desc",
      "value": "凝血障礙，小傷口也血流不止，傷病最是難醫。"
    },
    {
      "key": "defect_pale_name",
      "value": "白化"
    },
    {
      "key": "defect_pale_desc",
      "value": "膚發無色，畏光避日，白日出行也要以傘遮面。"
    },
    {
      "key": "depression_name",
      "value": "抑鬱"
    },
    {
      "key": "depression_desc",
      "value": "長期高壓下的意志消沉，對政務與人事提不起興致，日漸寡言。"
    },
    {
      "key": "anxiety_name",
      "value": "焦慮"
    },
    {
      "key": "anxiety_desc",
      "value": "終日憂懼不安，寢食難安，決斷遲疑，杯弓蛇影。"
    },
    {
      "key": "paranoia_name",
      "value": "偏執"
    },
    {
      "key": "paranoia_desc",
      "value": "懷疑身邊的一切人，把善意當作陰謀，睚眥必報。"
    },
    {
      "key": "delirium_name",
      "value": "譫妄"
    },
    {
      "key": "delirium_desc",
      "value": "神志昏亂，言語無狀，時而清醒時而糊塗，不識晝夜。"
    },
    {
      "key": "dementia_name",
      "value": "失智"
    },
    {
      "key": "dementia_desc",
      "value": "年邁帶來的心智衰退，往事如煙，認不清親人，性情大變。"
    },
    {
      "key": "ethnos_laethis_plural",
      "value": "萊希斯人"
    },
    {
      "key": "ethnos_laethis_adj",
      "value": "萊希斯的"
    }
  ]
}